[Unit]
Description=polyData content topic refresh worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/__POLYDATA_REPO_ROOT__
EnvironmentFile=%h/.config/polydata/polydata.env
Environment=POLYDATA_API_READONLY=0
Environment=POLYDATA_CONTENT_API_REFRESH_ENABLED=0
Environment=POLYDATA_CONTENT_MARKET_DYNAMIC=0
ExecStart=/bin/bash -lc 'POLYDATA_API_READONLY=0 POLYDATA_CONTENT_API_REFRESH_ENABLED=0 POLYDATA_CONTENT_MARKET_DYNAMIC=0 exec "${POLYDATA_PYTHON_BIN:-python3}" scripts/runtime/content_topic_refresh.py --watch --interval "${POLYDATA_CONTENT_TOPIC_REFRESH_INTERVAL_SECONDS:-900}" --limit-per-topic "${POLYDATA_CONTENT_TOPIC_REFRESH_LIMIT:-24}" --topics "${POLYDATA_CONTENT_TOPIC_IDS:-}"'
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=polydata-gcp.target

[Unit]
Description=polyData natural hazards snapshot seed watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/__POLYDATA_REPO_ROOT__
EnvironmentFile=%h/.config/polydata/polydata.env
ExecStart=/bin/bash -lc 'exec "${POLYDATA_PYTHON_BIN:-python3}" scripts/runtime/natural_hazards_watcher.py --watch --interval "${POLYDATA_NATURAL_HAZARDS_WATCH_INTERVAL_SECONDS:-90}"'
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=polydata-gcp.target

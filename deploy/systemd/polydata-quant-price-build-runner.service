[Unit]
Description=polyData quant OrderFilled block close price build worker
After=network-online.target polydata-db-reverse-tunnel.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/__POLYDATA_REPO_ROOT__
EnvironmentFile=%h/.config/polydata/polydata.env
ExecStart=/bin/bash -lc 'exec "${POLYDATA_PYTHON_BIN:-python3}" -m quant.build_runner --daemon --source-mode orderfilled_block_close --skip-maintenance --since-ts "${POLYDATA_QUANT_PRICE_BUILD_SINCE_TS:-1756684800}" --token-limit "${POLYDATA_QUANT_PRICE_BUILD_TOKEN_LIMIT:-40}" --block-token-limit "${POLYDATA_QUANT_BLOCK_TOKEN_LIMIT:-200}" --sleep-seconds "${POLYDATA_QUANT_BLOCK_SLEEP_SECONDS:-2}" --frontend-min-orderfilled-trades "${POLYDATA_QUANT_FRONTEND_MIN_ORDERFILLED_TRADES:-1000}" --frontend-window-seconds "${POLYDATA_QUANT_FRONTEND_WINDOW_SECONDS:-604800}" --frontend-overlap-seconds "${POLYDATA_QUANT_FRONTEND_OVERLAP_SECONDS:-21600}" --frontend-lag-seconds "${POLYDATA_QUANT_FRONTEND_LAG_SECONDS:-120}" --block-min-orderfilled-trades "${POLYDATA_QUANT_BLOCK_MIN_ORDERFILLED_TRADES:-1}" --block-window 50000000 --block-overlap "${POLYDATA_QUANT_BLOCK_OVERLAP:-2000}" --fidelity-minutes "${POLYDATA_QUANT_FRONTEND_FIDELITY_MINUTES:-1}"'
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=polydata-local-collector.target

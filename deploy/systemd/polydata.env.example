# Shared runtime environment for user-level systemd-managed polyData services.
# Copy to ~/.config/polydata/polydata.env and fill in real values.

POLYMARKET_DB_BACKEND=postgres
POLYDATA_DEPLOY_ROLE=gcp-api
POLYDATA_POSTGRES_HOST=127.0.0.1
POLYDATA_POSTGRES_PORT=45432
POLYDATA_POSTGRES_USER=poly_user
POLYDATA_POSTGRES_PASSWORD=REPLACE_ME
POLYDATA_POSTGRES_DATABASE=poly_data_core
POLYDATA_POSTGRES_SEARCH_PATH=core,oracle,ops,public

# Local collector only: keep the database reverse tunnel transport independent
# from the deployment target so it can use the most reliable SSH route.
POLYDATA_GCP_SSH_TARGET=
POLYDATA_GCP_TUNNEL_SSH_TARGET=
POLYDATA_GCP_TUNNEL_SSH_IDENTITY_FILE=
POLYDATA_GCP_TUNNEL_HEALTH_SSH_TARGET=
POLYDATA_GCP_TUNNEL_HEALTH_SSH_IDENTITY_FILE=
POLYDATA_TUNNEL_HEALTH_FAILURE_THRESHOLD=2

# OrderFilled ClickHouse read path.
# On the local collector host, docker exec is used when HTTP URL is empty.
# On GCP readonly API, setup_remote_readonly_api.sh forwards this URL over SSH.
POLYDATA_ORDERFILLED_CLICKHOUSE_READ_ENABLED=1
POLYDATA_ORDERFILLED_CLICKHOUSE_HTTP_URL=
POLYDATA_ORDERFILLED_CLICKHOUSE_CONTAINER=polydata_clickhouse_orderfilled
POLYDATA_ORDERFILLED_CLICKHOUSE_DATABASE=poly_orderfilled
POLYDATA_ORDERFILLED_CLICKHOUSE_USER=poly_user
POLYDATA_ORDERFILLED_CLICKHOUSE_READ_TABLE=orderfilled_fact
POLYDATA_ORDERFILLED_CLICKHOUSE_INSERT_TABLE=orderfilled_fact_buffer
POLYDATA_ORDERFILLED_CLICKHOUSE_FALLBACK_ON_UNAVAILABLE=0
CLICKHOUSE_PASSWORD=REPLACE_ME

# Volume-only alpha/whale signal thresholds backed by OrderFilled ClickHouse.
POLYDATA_WHALE_VOLUME_WINDOW_MINUTES=60
POLYDATA_WHALE_MIN_NOTIONAL=1000
POLYDATA_WHALE_ELEVATED_NOTIONAL=2500
POLYDATA_WHALE_CRITICAL_NOTIONAL=10000
POLYDATA_WHALE_MARKET_SHARE_THRESHOLD=0.10
POLYDATA_WHALE_RELATIVE_MIN_NOTIONAL=500
POLYDATA_ALPHA_VOLUME_WINDOW_MINUTES=15
POLYDATA_ALPHA_MARKET_BASELINE_MINUTES=60
POLYDATA_ALPHA_MIN_FLOW_NOTIONAL=1000
POLYDATA_ALPHA_MIN_SINGLE_TRADE_NOTIONAL=2500
POLYDATA_ALPHA_RELATIVE_MIN_FLOW_NOTIONAL=500
POLYDATA_ALPHA_MARKET_SHARE_THRESHOLD=0.12

# Self-hosted Polygon Bor RPC reached through polydata-polygon-rpc-tunnel.
# Legacy NODE_URL/Chainstack fallback is intentionally not supported.
POLYMARKET_RPC_URL=http://127.0.0.1:28545
POLYDATA_POLYGON_RPC_SSH_TARGET=
POLYDATA_POLYGON_RPC_SSH_IDENTITY_FILE=
POLYDATA_POLYGON_RPC_LOCAL_PORT=28545
POLYDATA_POLYGON_RPC_REMOTE_PORT=18545
POLYDATA_POLYGON_RPC_MAX_LAG_BLOCKS=5000

# Optional Python interpreter override, useful for conda or venv installs.
POLYDATA_PYTHON_BIN=python3
POLYDATA_PRODUCT_ALERT_INTERVAL_SECONDS=60

POLYDATA_API_READONLY=1
# Product identity is disabled until the product schema has been migrated and
# an initial administrator has been provisioned with scripts/api/manage_auth.py.
POLYDATA_AUTH_ENABLED=0
POLYDATA_AUTH_COOKIE_NAME=__Host-polydata-session
POLYDATA_AUTH_COOKIE_SECURE=1
POLYDATA_AUTH_SESSION_TTL_SECONDS=43200
POLYDATA_AUTH_AUDIT_PEPPER=

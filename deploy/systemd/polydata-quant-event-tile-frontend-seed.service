[Unit]
Description=polyData quant frontend event chart tile seed watcher
After=network-online.target redis-server.service polydata-api.service polydata-quant-frontend-active-seed.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/__POLYDATA_REPO_ROOT__
EnvironmentFile=%h/.config/polydata/polydata.env
ExecStart=/bin/bash -lc 'exec "${POLYDATA_PYTHON_BIN:-python3}" scripts/runtime/quant_event_tile_watcher.py --watch --interval "${POLYDATA_QUANT_EVENT_TILE_FRONTEND_INTERVAL_SECONDS:-120}" --ttl "${POLYDATA_QUANT_EVENT_TILE_FRONTEND_TTL_SECONDS:-240}" --max-events "${POLYDATA_QUANT_EVENT_TILE_FRONTEND_MAX_EVENTS:-20}" --price-source frontend --limit "${POLYDATA_QUANT_EVENT_TILE_FRONTEND_LIMIT:-250000}" --max-outcomes "${POLYDATA_QUANT_EVENT_TILE_FRONTEND_MAX_OUTCOMES:-100}" --top-n "${POLYDATA_QUANT_EVENT_TILE_FRONTEND_TOP_N:-12}" --max-points "${POLYDATA_QUANT_EVENT_TILE_FRONTEND_MAX_POINTS:-900}" --range full --resolution auto'
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=polydata-gcp.target

[Unit]
Description=polyData Market TV Wire seed watcher
After=network-online.target redis-server.service
Wants=network-online.target
# Bound process-level recovery when storage or a startup dependency is unavailable.
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/__POLYDATA_REPO_ROOT__
EnvironmentFile=%h/.config/polydata/polydata.env
ExecStart=/bin/bash -lc 'exec "${POLYDATA_PYTHON_BIN:-python3}" scripts/runtime/market_tv_wire_watcher.py --watch --interval "${POLYDATA_MARKET_TV_WIRE_WATCH_INTERVAL_SECONDS:-900}"'
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=polydata-gcp.target

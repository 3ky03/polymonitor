[Unit]
Description=polyData API service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/__POLYDATA_REPO_ROOT__
EnvironmentFile=%h/.config/polydata/polydata.env
ExecStartPre=/bin/bash -lc 'cd "/__POLYDATA_REPO_ROOT__/scripts" && "/__POLYDATA_REPO_ROOT__/.venv/bin/python" -m api.manage_auth migrate'
ExecStart=/bin/bash -lc 'POLYDATA_LOB_WEBSOCKET_ENABLED="$${POLYDATA_API_LOB_WEBSOCKET_ENABLED:-0}" exec "/__POLYDATA_REPO_ROOT__/.venv/bin/gunicorn" --workers "$${POLYDATA_GUNICORN_WORKERS:-3}" --threads "$${POLYDATA_GUNICORN_THREADS:-4}" --bind "$${POLYDATA_API_HOST:-127.0.0.1}:$${POLYDATA_API_PORT:-18500}" --timeout 180 --graceful-timeout 30 --max-requests "$${POLYDATA_GUNICORN_MAX_REQUESTS:-300}" --max-requests-jitter "$${POLYDATA_GUNICORN_MAX_REQUESTS_JITTER:-60}" scripts.api.app:app'
Restart=always
RestartSec=15
TimeoutStopSec=45
KillMode=mixed
OOMPolicy=kill
CPUQuota=180%
MemoryHigh=2G
MemoryMax=3G
TasksMax=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=polydata-gcp.target

[Unit]
Description=polyData quant backtest benchmark queue worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/__POLYDATA_REPO_ROOT__
EnvironmentFile=%h/.config/polydata/polydata.env
ExecStart=/bin/bash -lc 'exec "${POLYDATA_PYTHON_BIN:-python3}" -m quant.backtest.runners.benchmark_worker --skip-init-schema --poll-seconds "${POLYDATA_QUANT_BENCHMARK_WORKER_POLL_SECONDS:-2}" --stale-running-seconds "${POLYDATA_QUANT_BENCHMARK_STALE_RUNNING_SECONDS:-3600}"'
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=polydata-gcp.target

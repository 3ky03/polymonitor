[Unit]
Description=polyData quant orderfilled full event chart tile seed watcher
After=network-online.target redis-server.service polydata-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/__POLYDATA_REPO_ROOT__
EnvironmentFile=%h/.config/polydata/polydata.env
ExecStart=/bin/bash -lc 'exec "${POLYDATA_PYTHON_BIN:-python3}" scripts/runtime/quant_event_tile_watcher.py --watch --interval "${POLYDATA_QUANT_EVENT_TILE_ORDERFILLED_FULL_INTERVAL_SECONDS:-180}" --ttl "${POLYDATA_QUANT_EVENT_TILE_ORDERFILLED_FULL_TTL_SECONDS:-900}" --max-events "${POLYDATA_QUANT_EVENT_TILE_ORDERFILLED_FULL_MAX_EVENTS:-40}" --price-source orderfilled_block_close --limit "${POLYDATA_QUANT_EVENT_TILE_ORDERFILLED_FULL_LIMIT:-250000}" --max-outcomes "${POLYDATA_QUANT_EVENT_TILE_ORDERFILLED_FULL_MAX_OUTCOMES:-100}" --top-n "${POLYDATA_QUANT_EVENT_TILE_ORDERFILLED_FULL_TOP_N:-12}" --max-points "${POLYDATA_QUANT_EVENT_TILE_ORDERFILLED_FULL_MAX_POINTS:-900}" --range full --resolution auto'
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=polydata-gcp.target
